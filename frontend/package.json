{
  "name": "tonieesp-frontend",
  "version": "1.0.8",
  "description": "Home Assistant TonieESP Custom Sidepanel",
  "scripts": {
    "build": "esbuild src/tonieesp-panel.ts --bundle --minify --format=esm --target=es2022 --outfile=../custom_components/tonieesp/frontend/tonieesp-panel.js && cp ../custom_components/tonieesp/frontend/tonieesp-panel.js ../custom_components/tonieesp/frontend/frontend.js",
    "build:dev": "esbuild src/tonieesp-panel.ts --bundle --format=esm --target=es2022 --sourcemap --outfile=../custom_components/tonieesp/frontend/tonieesp-panel.js && cp ../custom_components/tonieesp/frontend/tonieesp-panel.js ../custom_components/tonieesp/frontend/frontend.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
